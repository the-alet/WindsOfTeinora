# Generates the shared numbers (shared/constants.txt) into C++, HLSL and the Unreal Python.
#   cmake -DIN=shared/constants.txt -DOUT=<build>/generated -P .utilities/gen_constants.cmake
# Run by the build as a CMake script, so the build never has to execute a freshly built tool.
# constants.txt: NAME  type  value[,value...]  # comment   (no semicolons or square brackets in comments)

if(NOT IN OR NOT OUT)
  message(FATAL_ERROR "usage: cmake -DIN=<constants.txt> -DOUT=<dir> -P gen_constants.cmake")
endif()

function(literal type value outvar)
  if(type STREQUAL "int")
    set(r "${value}")
  elseif(type STREQUAL "uint")
    set(r "${value}u")
  else()
    set(r "${value}")
    if(NOT r MATCHES "[.eE]")
      set(r "${r}.0")
    endif()
    if(NOT type STREQUAL "double")
      set(r "${r}f")
    endif()
  endif()
  set(${outvar} "${r}" PARENT_SCOPE)
endfunction()

set(banner "Generated from shared/constants.txt by .utilities/gen_constants.cmake. Do not edit.")
set(h "// ${banner}\n#pragma once\n\nnamespace taelia::k {\n")
set(hl "// ${banner}\n#ifndef TAELIA_SHARED_CONSTANTS_HLSLI\n#define TAELIA_SHARED_CONSTANTS_HLSLI\n\n")
set(py "# ${banner}\n\n")

file(STRINGS "${IN}" lines)
foreach(line IN LISTS lines)
  set(comment "")
  string(FIND "${line}" "#" hash)
  if(NOT hash EQUAL -1)
    math(EXPR after "${hash} + 1")
    string(SUBSTRING "${line}" ${after} -1 comment)
    string(STRIP "${comment}" comment)
    string(SUBSTRING "${line}" 0 ${hash} line)
  endif()
  string(STRIP "${line}" line)
  if(line STREQUAL "")
    continue()
  endif()
  if(NOT line MATCHES "^([A-Za-z_][A-Za-z0-9_]*)[ \t]+(int|uint|float|double|float2|float3|float4)[ \t]+([^ \t]+)$")
    message(FATAL_ERROR "constants.txt: bad line: ${line}")
  endif()
  set(name "${CMAKE_MATCH_1}")
  set(type "${CMAKE_MATCH_2}")
  string(REPLACE "," ";" values "${CMAKE_MATCH_3}")
  list(LENGTH values count)
  set(want 1)
  if(type MATCHES "^float([234])$")
    set(want ${CMAKE_MATCH_1})
  endif()
  if(NOT count EQUAL want)
    message(FATAL_ERROR "constants.txt: ${name} needs ${want} values")
  endif()
  set(cc "")
  set(pc "")
  if(NOT comment STREQUAL "")
    set(cc "  // ${comment}")
    set(pc "  # ${comment}")
  endif()

  if(want EQUAL 1)
    literal(${type} "${values}" lit)
    set(ctype ${type})
    if(type STREQUAL "uint")
      set(ctype "unsigned")
    endif()
    set(htype ${type})
    set(hlit "${lit}")
    if(type STREQUAL "double")
      set(htype "float")
      literal(float "${values}" hlit)
    endif()
    string(APPEND h "inline constexpr ${ctype} ${name} = ${lit};${cc}\n")
    string(APPEND hl "static const ${htype} K_${name} = ${hlit};${cc}\n")
    string(APPEND py "${name} = ${values}${pc}\n")
  else()
    set(lits "")
    foreach(v IN LISTS values)
      literal(float "${v}" lit)
      list(APPEND lits "${lit}")
    endforeach()
    list(JOIN lits ", " joined)
    list(JOIN values ", " pyjoined)
    string(APPEND h "inline constexpr float ${name}[${want}] = {${joined}};${cc}\n")
    string(APPEND hl "static const ${type} K_${name} = ${type}(${joined});${cc}\n")
    string(APPEND py "${name} = (${pyjoined})${pc}\n")
  endif()
endforeach()

string(APPEND h "}  // namespace taelia::k\n")
string(APPEND hl "\n#endif\n")
file(WRITE "${OUT}/taelia/shared_constants.h" "${h}")
file(WRITE "${OUT}/shaders/shared_constants.hlsli" "${hl}")
file(WRITE "${OUT}/unreal/shared_constants.py" "${py}")
